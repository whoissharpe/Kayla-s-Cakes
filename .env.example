# ---------------------------------------------------------------------------
# Kayla's Cakes — environment template
# Copy to .dev.vars (Worker local dev). NEVER commit real values.
# Production values live in Cloudflare Worker secrets:
#   npx wrangler secret put <NAME> --config worker/wrangler.toml
# ---------------------------------------------------------------------------

# Transactional email (Resend — https://resend.com). Used to email Kayla on each new lead.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where new-lead notifications are delivered. CONFIRM THIS ADDRESS WITH KAYLA.
NOTIFY_EMAIL=kaylascakesbakedwithlove@gmail.com

# Verified sender on your Resend domain. Must be a domain you control.
FROM_EMAIL=orders@kaylascakes.com

# /admin gate. Store the SHA-256 hash of the password, never the password.
# Generate:  echo -n 'your-password' | shasum -a 256
ADMIN_PASSWORD_HASH=

# Random 32+ char string used to sign the admin session cookie.
# Generate:  openssl rand -hex 32
SESSION_SECRET=

# Public origin allowed to POST the order form (CORS).
ALLOWED_ORIGIN=https://kaylascakes.pages.dev
