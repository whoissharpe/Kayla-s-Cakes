{
  "name": "kaylas-cakes",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "db:local": "wrangler d1 execute kaylas-cakes-leads --local --file=worker/schema.sql --config worker/wrangler.toml",
    "db:remote": "wrangler d1 execute kaylas-cakes-leads --remote --file=worker/schema.sql --config worker/wrangler.toml"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/jost": "^5.1.0",
    "astro": "^5.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
