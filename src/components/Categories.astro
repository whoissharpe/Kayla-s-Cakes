---
import Section from './Section.astro';
import { categories } from '../data/categories';
---
<Section
  id="what-she-makes"
  eyebrow="What she makes"
  title="A little of everything sweet"
  lede="Every order is made to fit the party it's going to. If you don't see what you're after, just ask — she'll tell you straight whether she can do it."
>
  <ul role="list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {categories.map((c) => (
      <li class="group overflow-hidden rounded-card border border-mint-300/60 bg-white transition-shadow hover:shadow-[0_2px_4px_rgb(20_20_20/0.03),0_16px_40px_rgb(34_104_93/0.12)]">
        <div class="aspect-[4/3] overflow-hidden bg-mint-100">
          <img
            src={c.image}
            alt=""
            width="600"
            height="450"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          />
        </div>
        <div class="p-5">
          <h3 class="text-lg font-semibold">{c.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/72">{c.blurb}</p>
        </div>
      </li>
    ))}
  </ul>
</Section>
