---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 bg-ink text-cream">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-display text-xl">{site.name}</p>
        <p class="mt-1 text-sm tracking-[0.2em] text-gold-500 uppercase">
          {site.tagline}
        </p>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-widest text-cream/60 uppercase">
          Get in touch
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a class="hover:text-gold-500 hover:underline" href={site.phoneHref}>
              Text {site.phone}
            </a>
          </li>
          <li>
            <a class="hover:text-gold-500 hover:underline" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          </li>
          <li><a class="hover:text-gold-500 hover:underline" href="/order">Order a cake</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-widest text-cream/60 uppercase">
          Follow along
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a class="hover:text-gold-500 hover:underline" href={site.instagram}
               rel="me noopener" target="_blank">
              Instagram {site.instagramHandle}
            </a>
          </li>
          <li>
            <a class="hover:text-gold-500 hover:underline" href={site.facebook}
               rel="me noopener" target="_blank">
              Facebook
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold tracking-widest text-cream/60 uppercase">
          Service area
        </h2>
        <p class="mt-3 text-sm text-cream/85">{site.serviceArea}</p>
      </div>
    </div>

    <div class="rule-gold my-10" aria-hidden="true"></div>

    <p class="max-w-3xl text-xs leading-relaxed text-cream/70">
      {site.cottageDisclosure}
    </p>
    <p class="mt-4 text-xs text-cream/55">
      © {year} {site.name}. Baked in {site.city}, {site.state}.
    </p>
  </div>
</footer>
