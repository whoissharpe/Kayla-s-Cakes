---
import { site } from '../data/site';

const links = [
  { href: '/#what-she-makes', label: 'What she makes' },
  { href: '/#gallery', label: 'Gallery' },
  { href: '/#how-it-works', label: 'How ordering works' },
  { href: '/#about', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-mint-300/50 bg-cream/85 backdrop-blur-md">
  <nav aria-label="Main" class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <img
        src="/brand/logo-mark.webp"
        alt=""
        width="40"
        height="40"
        class="h-9 w-9 object-contain sm:h-10 sm:w-10"
      />
      <span class="font-display text-lg font-semibold text-ink sm:text-xl">
        {site.name}
      </span>
    </a>

    <ul class="ml-auto hidden items-center gap-7 lg:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="text-sm text-ink/75 transition-colors hover:text-mint-800"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="/order"
      class="ml-auto rounded-btn bg-mint-800 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-ink lg:ml-0"
    >
      Order a cake
    </a>
  </nav>
</header>
