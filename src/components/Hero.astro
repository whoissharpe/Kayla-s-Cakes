---
import { site } from '../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <!-- Full-bleed background. Poster always present; the video source is only
       attached when motion is allowed, so reduced-motion visitors and
       save-data connections never download it. -->
  <div class="hero__bg" aria-hidden="true">
    <picture>
      <source srcset="/brand/hero-cake.webp" type="image/webp" />
      <img src="/brand/hero-cake.jpg" alt="" class="hero__img" width="2400" height="1340" fetchpriority="high" />
    </picture>
    <video
      class="hero__video" data-hero-video
      data-src="/brand/hero-cake-spin.mp4"
      poster="/brand/hero-cake.webp"
      muted loop playsinline preload="none" tabindex="-1"
    ></video>
    <div class="hero__scrim"></div>
    <div class="hero__flecks">
      {Array.from({ length: 8 }).map((_, i) => <span class:list={['fleck', `fleck--${i + 1}`]}></span>)}
    </div>
  </div>

  <div class="hero__inner">
    <img
      src="/brand/logo-lockup.webp"
      alt={`${site.name} — ${site.tagline}`}
      class="hero__badge"
      width="800" height="1071"
      fetchpriority="high"
    />

    <p class="hero__eyebrow">Jacksonville · Ponte Vedra · St. Augustine · Nocatee</p>

    <h1 id="hero-heading" class="hero__title">
      Cakes for the day you'll remember
    </h1>

    <p class="hero__lede">{site.positioning}</p>

    <div class="hero__cta">
      <a href="/order" class="btn btn--primary">Order a cake</a>
      <a href="/#gallery" class="btn btn--ghost">See the gallery</a>
    </div>

    <ul class="hero__points">
      {site.differentiators.map((d) => <li>{d}</li>)}
    </ul>

    <p class="hero__status">
      <span class="hero__dot" aria-hidden="true"></span>
      Now taking orders for birthdays, showers and weddings
    </p>
  </div>

  <a href="#what-she-makes" class="hero__scroll" aria-label="Skip to what she makes">
    <span aria-hidden="true">↓</span>
  </a>
</section>

<script is:inline>
  (() => {
    const video = document.querySelector('[data-hero-video]');
    if (!video) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (navigator.connection?.saveData) return;

    video.src = video.dataset.src;
    video.load();
    video.addEventListener('canplay', () => {
      video.play().then(() => video.setAttribute('data-ready', '')).catch(() => {});
    }, { once: true });

    // Don't animate a hero nobody is looking at.
    new IntersectionObserver(([e]) => {
      e.isIntersecting ? video.play().catch(() => {}) : video.pause();
    }, { threshold: 0.05 }).observe(video);
  })();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(100svh, 920px);
    display: grid;
    align-items: center;
    padding: 7rem 1.25rem 5rem;
    overflow: hidden;
    background: var(--color-cream);
  }
  @media (min-width: 64rem) { .hero { padding: 8rem 2.5rem 6rem; } }

  /* --- Background ------------------------------------------------------- */
  .hero__bg { position: absolute; inset: 0; z-index: -1; }
  .hero__bg picture { display: block; height: 100%; }

  .hero__img,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the cake in frame on tall phones where the crop is tightest */
    object-position: 72% center;
  }
  @media (min-width: 64rem) { .hero__img, .hero__video { object-position: 62% center; } }

  .hero__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 900ms ease;
  }
  .hero__video[data-ready] { opacity: 1; }

  /*
   * Cream wash rather than a colour tint: the photograph keeps its own
   * colour on the right, and the left fades to the page background so dark
   * ink text sits on cream at full contrast.
   */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(96deg,
        rgb(253 251 247 / 0.99) 0%,
        rgb(253 251 247 / 0.97) 30%,
        rgb(253 251 247 / 0.72) 50%,
        rgb(253 251 247 / 0.18) 68%,
        rgb(253 251 247 / 0) 84%);
  }
  @media (max-width: 63.99rem) {
    /* No room beside the cake on small screens, but the photo is the whole
       point of a hero — wash just enough at top and bottom for the badge
       and copy to stay legible, and let the cake itself show through in
       the middle instead of nearly disappearing under solid cream. */
    .hero__scrim {
      background:
        linear-gradient(180deg,
          rgb(253 251 247 / 0.82) 0%,
          rgb(253 251 247 / 0.55) 22%,
          rgb(253 251 247 / 0.5) 45%,
          rgb(253 251 247 / 0.86) 75%,
          rgb(253 251 247 / 0.95) 100%);
    }
  }

  /* --- Content ---------------------------------------------------------- */
  .hero__inner {
    position: relative;
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
  }
  @media (min-width: 64rem) { .hero__inner > * { max-width: 36rem; } }

  .hero__badge {
    width: clamp(7rem, 14vw, 11.5rem);
    height: auto;
    margin-bottom: 1.35rem;
    /* No ring, no plate — the lockup's own canvas is transparent (colour-keyed
       from its white background, not baked in) so it sits directly on the
       page. Anything added here reads as a second border against the logo's
       own artwork. */
  }

  .hero__eyebrow {
    font-size: clamp(0.68rem, 1.5vw, 0.78rem);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-mint-800);
    margin-bottom: 0.9rem;
    text-wrap: balance;
  }

  .hero__title {
    font-size: clamp(2.4rem, 5.4vw, 4rem);
    line-height: 1.02;
    max-width: 14ch;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero__lede {
    margin-top: 1.1rem;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.6;
    color: rgb(20 20 20 / 0.75);
  }

  .hero__cta { margin-top: 1.9rem; display: flex; flex-wrap: wrap; gap: 0.85rem; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0 1.9rem;
    border-radius: var(--radius-btn);
    font-size: 1rem;
    font-weight: 600;
    transition: background-color 200ms ease, color 200ms ease, transform 200ms ease, border-color 200ms ease;
  }
  .btn:hover { transform: translateY(-2px); }

  /* mint-800 behind white reads 12.44; mint-600 would fail at 2.95 */
  .btn--primary {
    background: var(--color-mint-800);
    color: #fff;
    box-shadow: 0 2px 6px rgb(18 63 56 / 0.12), 0 14px 34px rgb(18 63 56 / 0.2);
  }
  .btn--primary:hover { background: var(--color-mint-950); }

  .btn--ghost {
    color: var(--color-mint-800);
    background: rgb(253 251 247 / 0.75);
    border: 1px solid var(--color-mint-600);
    backdrop-filter: blur(4px);
  }
  .btn--ghost:hover { background: var(--color-mint-100); border-color: var(--color-mint-800); }

  .hero__points {
    margin-top: 1.9rem;
    display: grid;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: rgb(20 20 20 / 0.78);
  }
  .hero__points li { position: relative; padding-left: 1.6rem; line-height: 1.45; }
  .hero__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-blush);
  }

  .hero__status {
    margin-top: 1.6rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-mint-800);
  }
  .hero__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-mint-600);
    box-shadow: 0 0 0 0 rgb(63 166 151 / 0.7);
    animation: pulse 2.6s ease-out infinite;
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgb(63 166 151 / 0.55); }
    70%  { box-shadow: 0 0 0 0.7rem rgb(63 166 151 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(63 166 151 / 0); }
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgb(34 104 93 / 0.35);
    color: var(--color-mint-800);
    background: rgb(253 251 247 / 0.7);
    font-size: 1.1rem;
    animation: nudge 2.8s ease-in-out infinite;
  }
  .hero__scroll:hover { background: var(--color-mint-100); }
  @keyframes nudge {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(6px); }
  }

  /* --- Gold flecks ------------------------------------------------------ */
  .hero__flecks { position: absolute; inset: 0; pointer-events: none; }
  .fleck {
    position: absolute;
    width: 3px; height: 3px;
    border-radius: 50%;
    background: var(--color-gold-500);
    box-shadow: 0 0 7px rgb(201 162 75 / 0.85);
    opacity: 0;
    will-change: transform;
    animation: rise 17s linear infinite;
  }
  @keyframes rise {
    0%   { transform: translate3d(0, 0, 0); opacity: 0; }
    18%  { opacity: 0.95; }
    82%  { opacity: 0.5; }
    100% { transform: translate3d(16px, -140px, 0); opacity: 0; }
  }
  /* Kept clear of .hero__inner's text column (roughly the left half on
     desktop) — a stray fleck drifting through empty cream space next to the
     copy reads as a screen artifact, not a decoration. */
  .fleck--1 { left: 52%; top: 80%; animation-delay: 0s;    animation-duration: 18s; }
  .fleck--2 { left: 60%; top: 90%; animation-delay: 3.2s;  animation-duration: 21s; }
  .fleck--3 { left: 68%; top: 74%; animation-delay: 6.4s;  animation-duration: 16s; }
  .fleck--4 { left: 76%; top: 92%; animation-delay: 9.1s;  animation-duration: 23s; }
  .fleck--5 { left: 82%; top: 82%; animation-delay: 4.7s;  animation-duration: 19s; }
  .fleck--6 { left: 88%; top: 90%; animation-delay: 12.3s; animation-duration: 17s; }
  .fleck--7 { left: 93%; top: 76%; animation-delay: 7.6s;  animation-duration: 22s; }
  .fleck--8 { left: 97%; top: 85%; animation-delay: 15s;   animation-duration: 20s; }
  @media (max-width: 63.99rem) {
    /* Below the desktop split there's no separate photo lane — the scrim
       washes the whole frame (see .hero__scrim above) and content stacks in
       one column, so let flecks spread back across the full width. */
    .fleck--1 { left: 10%; }
    .fleck--2 { left: 24%; }
    .fleck--3 { left: 38%; }
    .fleck--4 { left: 50%; }
  }

  /* Slow parallax where supported — progressive enhancement, no JS handler */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      @keyframes drift { to { transform: translate3d(0, 7%, 0) scale(1.08); } }
      .hero__img, .hero__video {
        animation: drift linear both;
        animation-timeline: scroll();
      }
    }
  }

  /* Full static fallback. No exceptions. */
  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
    .hero__img { animation: none; }
    .hero__flecks { display: none; }
    .hero__dot { animation: none; }
    .hero__scroll { animation: none; }
    .btn:hover { transform: none; }
  }
</style>
