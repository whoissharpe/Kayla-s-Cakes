---
import Section from './Section.astro';

/* Her actual stated process — keep the substance verbatim. */
const steps = [
  {
    n: '01',
    title: 'Send your details',
    body: "Tell her the date of the event, the cake flavor, the size or how many servings you need, and the theme — photos of inspiration help a lot. List anything specific you'd like, like a color scheme or decorations to match.",
  },
  {
    n: '02',
    title: 'Get your invoice',
    body: 'Once your details are finalized, she sends an invoice. Payment in full books the order. Anything over $100 can be split into payments.',
  },
  {
    n: '03',
    title: 'Pick up',
    body: "You'll arrange a pickup time together, so it's ready right when you need it.",
  },
];
---
<Section
  id="how-it-works"
  eyebrow="How ordering works"
  title="Three steps, no guesswork"
  lede="No account to make, no cart to fill. Tell her what you're imagining and she'll take it from there."
  tone="mint"
  watermark
>
  <ol role="list" class="steps">
    {steps.map((s) => (
      <li class="step">
        <span class="step__n" aria-hidden="true">{s.n}</span>
        <h3 class="step__title">{s.title}</h3>
        <p class="step__body">{s.body}</p>
      </li>
    ))}
  </ol>

  <a href="/order" class="steps__cta">Start your order</a>
</Section>

<style>
  .steps {
    display: grid;
    gap: 2.5rem;
    counter-reset: step;
  }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  .step { position: relative; padding-top: 1.75rem; border-top: 1px solid rgb(34 104 93 / 0.22); }

  .step__n {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-mint-600);
  }
  .step__title { margin-top: 0.9rem; font-size: 1.3rem; font-weight: 600; color: var(--color-ink); }
  .step__body { margin-top: 0.85rem; font-size: 0.95rem; line-height: 1.65; color: rgb(20 20 20 / 0.72); }

  .steps__cta {
    display: inline-flex;
    align-items: center;
    min-height: 3.25rem;
    margin-top: 3.5rem;
    padding: 0 2rem;
    border-radius: var(--radius-btn);
    background: var(--color-mint-800);
    color: #fff;
    font-weight: 600;
    transition: background-color 200ms ease, transform 200ms ease;
  }
  .steps__cta:hover { background: var(--color-mint-950); transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .steps__cta:hover { transform: none; } }
</style>
