---
import { site } from '../data/site';
import { categories } from '../data/categories';

/* Blocks past dates at render time; the Worker re-checks server-side. */
const today = new Date().toISOString().split('T')[0];
---

<form
  class="order-form"
  method="post"
  action={`${site.orderEndpoint}/api/order`}
  enctype="multipart/form-data"
  novalidate
  data-order-form
>
  <!-- Honeypot. Real people never see or fill this. -->
  <div class="hp" aria-hidden="true">
    <label for="company">Company (leave blank)</label>
    <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
  </div>

  <fieldset class="fs">
    <legend class="fs__legend">How to reach you</legend>

    <div class="field">
      <label for="name">Your name <span class="req" aria-hidden="true">*</span></label>
      <input type="text" id="name" name="name" required autocomplete="name"
             aria-describedby="name-err" />
      <p class="err" id="name-err" data-err-for="name"></p>
    </div>

    <div class="field">
      <span class="label" id="contact-method-label">
        Best way to reach you <span class="req" aria-hidden="true">*</span>
      </span>
      <div class="radios" role="radiogroup" aria-labelledby="contact-method-label">
        <label class="radio">
          <input type="radio" name="contactMethod" value="text" checked />
          <span>Text</span>
        </label>
        <label class="radio">
          <input type="radio" name="contactMethod" value="email" />
          <span>Email</span>
        </label>
      </div>
    </div>

    <div class="grid-2">
      <div class="field">
        <label for="phone">Phone</label>
        <input type="tel" id="phone" name="phone" autocomplete="tel"
               inputmode="tel" aria-describedby="phone-err" />
        <p class="err" id="phone-err" data-err-for="phone"></p>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email"
               aria-describedby="email-err" />
        <p class="err" id="email-err" data-err-for="email"></p>
      </div>
    </div>
  </fieldset>

  <fieldset class="fs">
    <legend class="fs__legend">About your order</legend>

    <div class="grid-2">
      <div class="field">
        <label for="eventDate">Date of event <span class="req" aria-hidden="true">*</span></label>
        <input type="date" id="eventDate" name="eventDate" required min={today}
               aria-describedby="eventDate-hint eventDate-err" />
        <p class="hint" id="eventDate-hint">The day you need it, not the pickup day.</p>
        <p class="err" id="eventDate-err" data-err-for="eventDate"></p>
      </div>

      <div class="field">
        <label for="itemType">What are you after? <span class="req" aria-hidden="true">*</span></label>
        <select id="itemType" name="itemType" required aria-describedby="itemType-err">
          <option value="">Choose one…</option>
          {categories.map((c) => <option value={c.title}>{c.title}</option>)}
          <option value="Something else">Something else</option>
        </select>
        <p class="err" id="itemType-err" data-err-for="itemType"></p>
      </div>
    </div>

    <div class="grid-2">
      <div class="field">
        <label for="flavor">Cake flavor</label>
        <input type="text" id="flavor" name="flavor"
               placeholder="Vanilla, chocolate, strawberry…" />
      </div>
      <div class="field">
        <label for="servings">Size or servings needed</label>
        <input type="text" id="servings" name="servings"
               placeholder="6 inch, two tier, about 25 people…" />
      </div>
    </div>

    <div class="field">
      <label for="theme">Theme, colors, and decorations</label>
      <textarea id="theme" name="theme" rows="4"
        placeholder="Tell her the theme, the color scheme, and anything specific you'd like on the cake."
      ></textarea>
    </div>

    <div class="field">
      <label for="photos">Inspiration photos</label>
      <input type="file" id="photos" name="photos" accept="image/*" multiple
             aria-describedby="photos-hint photos-err" />
      <p class="hint" id="photos-hint">
        Up to 5 images, 5 MB each. Screenshots and blurry photos are fine.
      </p>
      <p class="err" id="photos-err" data-err-for="photos"></p>
    </div>

    <div class="grid-2">
      <div class="field">
        <label for="budget">Budget</label>
        <input type="text" id="budget" name="budget" placeholder="Optional, but it helps" />
      </div>
      <div class="field">
        <label for="notes">Anything else</label>
        <input type="text" id="notes" name="notes" placeholder="Allergies, pickup timing…" />
      </div>
    </div>
  </fieldset>

  <p class="form-note">
    She'll get back to you with an invoice once the details are settled. Payment
    in full books the date, and anything over $100 can be split into payments.
  </p>

  <div class="actions">
    <button type="submit" class="submit" data-submit>Send my details</button>
    <p class="fallback">
      Trouble with the form? Text
      <a href={site.phoneHref}>{site.phone}</a> or
      <a href={`mailto:${site.email}`}>email her</a>.
    </p>
  </div>

  <!-- Announced to screen readers on submit -->
  <p class="status" role="status" aria-live="polite" data-status></p>
</form>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-order-form]');
    if (!form) return;

    const status = form.querySelector('[data-status]');
    const btn = form.querySelector('[data-submit]');
    const MAX_FILES = 5;
    const MAX_BYTES = 5 * 1024 * 1024;

    const setErr = (name, msg) => {
      const el = form.querySelector(`[data-err-for="${name}"]`);
      const input = form.elements[name];
      if (el) el.textContent = msg || '';
      if (input && input.setAttribute) {
        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      }
    };

    const validate = () => {
      let firstBad = null;
      const fail = (n, m) => { setErr(n, m); if (!firstBad) firstBad = n; };

      ['name', 'phone', 'email', 'eventDate', 'itemType', 'photos']
        .forEach((n) => setErr(n, ''));

      const d = new FormData(form);
      if (!String(d.get('name') || '').trim()) fail('name', 'Please tell her your name.');

      const method = d.get('contactMethod');
      const email = String(d.get('email') || '').trim();
      const phone = String(d.get('phone') || '').trim();

      if (method === 'email') {
        if (!email) fail('email', 'Add an email so she can reply.');
        else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) fail('email', "That email doesn't look right.");
      } else {
        if (!phone) fail('phone', 'Add a phone number so she can text you.');
        else if (phone.replace(/\D/g, '').length < 10) fail('phone', 'Please include the area code.');
      }

      const date = String(d.get('eventDate') || '');
      if (!date) fail('eventDate', 'When do you need it?');
      else {
        const picked = new Date(date + 'T00:00:00');
        const today = new Date(); today.setHours(0, 0, 0, 0);
        if (picked < today) fail('eventDate', 'Please pick a date in the future.');
      }

      if (!d.get('itemType')) fail('itemType', 'Pick what you would like.');

      const files = form.elements['photos'].files;
      if (files.length > MAX_FILES) fail('photos', `Up to ${MAX_FILES} images, please.`);
      else for (const f of files) {
        if (f.size > MAX_BYTES) { fail('photos', `"${f.name}" is over 5 MB.`); break; }
      }

      return firstBad;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const bad = validate();
      if (bad) {
        status.textContent = 'Please fix the highlighted fields.';
        form.elements[bad]?.focus();
        return;
      }

      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Sending…';
      status.textContent = '';

      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body.error || `Request failed (${res.status})`);
        }
        form.innerHTML =
          '<div class="success" role="status">' +
          '<h3>Got it — thank you!</h3>' +
          '<p>Your details are on their way to Kayla. She usually replies within a couple of days, ' +
          'and the next thing you\'ll get is an invoice once everything is settled.</p>' +
          '</div>';
        document.querySelector('.success')?.scrollIntoView({ block: 'center' });
      } catch (err) {
        btn.disabled = false;
        btn.textContent = original;
        status.textContent =
          "Sorry — that didn't send. Please try again, or text her directly.";
      }
    });
  })();
</script>

<style>
  .order-form { max-width: 46rem; }

  .hp {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%);
    white-space: nowrap; border: 0;
  }

  .fs { border: 0; padding: 0; margin: 0 0 2.25rem; }
  .fs__legend {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    padding: 0 0 1rem;
  }

  .field { margin-bottom: 1.25rem; }
  .grid-2 { display: grid; gap: 0 1rem; }
  @media (min-width: 40rem) { .grid-2 { grid-template-columns: 1fr 1fr; } }

  label, .label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .req { color: var(--color-mint-800); }

  input[type='text'], input[type='tel'], input[type='email'],
  input[type='date'], select, textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-mint-300);
    border-radius: var(--radius-btn);
    background: #fff;
    color: var(--color-ink);
    font: inherit;
    font-size: 1rem; /* 16px — stops iOS zooming on focus */
  }
  textarea { min-height: 7rem; resize: vertical; }

  input:hover, select:hover, textarea:hover { border-color: var(--color-mint-600); }
  [aria-invalid='true'] { border-color: #A33; }

  input[type='file'] {
    width: 100%;
    font-size: 0.9rem;
    padding: 0.65rem 0;
  }
  input[type='file']::file-selector-button {
    margin-right: 0.75rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-mint-600);
    border-radius: var(--radius-btn);
    background: var(--color-mint-100);
    color: var(--color-mint-800);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .radios { display: flex; gap: 1.5rem; }
  .radio { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 400; margin: 0; }
  .radio input { width: 1.15rem; height: 1.15rem; accent-color: var(--color-mint-800); }

  .hint { margin-top: 0.35rem; font-size: 0.8rem; color: rgb(20 20 20 / 0.6); }
  .err:empty { display: none; }
  .err { margin-top: 0.35rem; font-size: 0.8rem; font-weight: 500; color: #A33; }

  .form-note {
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--color-gold-500);
    background: var(--color-mint-100);
    border-radius: 0 var(--radius-btn) var(--radius-btn) 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgb(20 20 20 / 0.8);
  }

  .actions { margin-top: 1.75rem; }
  .submit {
    min-height: 3.25rem;
    padding: 0 2rem;
    border-radius: var(--radius-btn);
    background: var(--color-mint-800);
    color: #fff;
    font-size: 1rem;
    font-weight: 500;
    transition: background-color 180ms ease;
  }
  .submit:hover:not(:disabled) { background: var(--color-ink); }
  .submit:disabled { opacity: 0.6; cursor: progress; }

  .fallback { margin-top: 0.9rem; font-size: 0.85rem; color: rgb(20 20 20 / 0.65); }
  .fallback a { color: var(--color-mint-800); text-decoration: underline; text-underline-offset: 3px; }

  .status:empty { display: none; }
  .status { margin-top: 1rem; font-size: 0.9rem; font-weight: 500; color: #A33; }

  .success {
    padding: 2rem;
    border-radius: var(--radius-card);
    background: var(--color-mint-100);
    border: 1px solid var(--color-mint-300);
  }
  .success h3 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; }
  .success p { margin-top: 0.75rem; line-height: 1.6; color: rgb(20 20 20 / 0.8); }
</style>
