---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  tone?: 'cream' | 'mint';
}
const { id, eyebrow, title, lede, tone = 'cream' } = Astro.props;
---
<section
  id={id}
  aria-labelledby={`${id}-heading`}
  class:list={['py-20 sm:py-24', tone === 'mint' ? 'bg-mint-100' : 'bg-cream']}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <header class="max-w-2xl">
      {eyebrow && (
        <p class="text-xs font-medium tracking-[0.28em] text-mint-800 uppercase">
          {eyebrow}
        </p>
      )}
      <h2 id={`${id}-heading`} class="mt-3 text-3xl font-semibold sm:text-4xl">
        {title}
      </h2>
      {lede && <p class="mt-4 text-base leading-relaxed text-ink/75">{lede}</p>}
    </header>
    <div class="mt-12"><slot /></div>
  </div>
</section>
